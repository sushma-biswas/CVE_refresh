# .env.example — Credential template for the CVE refresh pipeline.
#
# Copy this file to .env in the project root and fill in your values.
# The .env file is gitignored and must NEVER be committed to version control.
#
# On the server:
#   cp config/.env.example .env
#   chmod 600 .env

# ── Snowflake connection ──────────────────────────────────────────────────
# Account identifier format: <orgname>-<accountname>  (e.g. myorg-xy12345)
# Find yours at: https://app.snowflake.com → account menu → copy account identifier
SNOWFLAKE_ACCOUNT=yourorg-youraccount

SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password

SNOWFLAKE_DATABASE=CVE_DB
SNOWFLAKE_SCHEMA=CVE_SCHEMA
SNOWFLAKE_WAREHOUSE=CVE_WH

# Optional — remove this line to use your user's default role
SNOWFLAKE_ROLE=DBT_ROLE

# ── dbt target ────────────────────────────────────────────────────────────
# Controls which target in dbt/profiles.yml is used by the pipeline.
# Set to "dev" when testing locally against a dev schema.
DBT_TARGET=prod

# ── GitHub API (optional) ─────────────────────────────────────────────────
# Without a token the GitHub API allows 60 requests/hour (unauthenticated).
# With a personal access token (no scopes needed for public repos) the limit
# is 5,000 requests/hour.
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=
